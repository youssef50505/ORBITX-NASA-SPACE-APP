# ==============================================================================
# MARS SENTINEL — Git Ignore Configuration
# ==============================================================================

# Python bytecode and execution caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/

# Large 3D binaries & Blender auto-backups (exceeds GitHub 100MB limit)
*.blend
*.blend1
*.blend@
*.blend[0-9]
*.glb
!unity_project/Assets/**/*.glb
!unity_project/Assets/**/*.glb.meta
!data/missions_3d/**/*.glb
!**/assets/models/*.glb

# Raw scientific GIS datasets and huge numerical grids (>100 MB)
data/*.tif
data/*.tiff
data/*.JP2
data/*.jp2
data/*.npz
data/jez_hirise_1m_detail_grid.json
data/jez_hirise_site_detail_4m.json
data/jez_hirise_1m_overview_grid.json
data/jez_ctx_20m_grid.json

# Nav-module heavy binary/scratch archives (keep core nav.py, routes.json, test_nav.py, blender_view_routes.py)
nav-module/Base Idea/*.zip
nav-module/Base Idea/**/*.tif
nav-module/Base Idea/**/*.tiff
nav-module/Base Idea/*.blend
nav-module/Base Idea/*.blend1

# Stale / ephemeral preview renders & diagnostics
previews/test_*.png
previews/*thumb*.png

# Temporary inspection dumps and untrusted text datablocks
data/inspect_*.json
data/*.untrusted.txt
data/field_asset_bounds.json

# OS and Editor metadata
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.bak

# Local workspace agent/test ephemera and archives
.agents/
archive/
TEST_INFRA.md
TEST_READY.md

# Unreal Engine 5.8 generated build caches & imported binary uassets (rebuilt via Scripts/build_mars_sentinel_ue5.py)
unreal_project/Binaries/
unreal_project/Intermediate/
unreal_project/Saved/
unreal_project/DerivedDataCache/
unreal_project/.vs/
