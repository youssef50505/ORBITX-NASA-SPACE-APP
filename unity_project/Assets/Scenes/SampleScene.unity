  targetId: nasa_mark3_spacesuit_exhibit
  title: NASA Mark III H-1 Planetary EVA Suit
  category: "Official NASA 3D Hardware \xB7 Life Support Exhibit"
  subtitle: "Rear-Entry Hard Upper Torso \xB7 57 kPa Exploration Suit"
  coordinatesText: "HDU Suitport Pad \xB7 18.4448\xB0N, 77.4505\xB0E"
  geologyText: Engineered for high hip/knee mobility across crater slopes and rocky Jezero regolith.
